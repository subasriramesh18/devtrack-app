# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/devtrack?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=devtrack_jwt_secret_key_2026_super_secure_auth
JWT_EXPIRES_IN=7d
